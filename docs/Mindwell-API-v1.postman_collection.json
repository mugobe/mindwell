{
  "info": {
    "name": "Mindwell API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mindwell mobile API (clients only). Run 'Auth \u2192 Log in' first; it saves the token. Requests that create things save the ids they return (session_id, transaction_id \u2026) for the next requests."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "transaction_id",
      "value": ""
    },
    {
      "key": "therapist_id",
      "value": ""
    },
    {
      "key": "plan_id",
      "value": ""
    },
    {
      "key": "conversation_id",
      "value": ""
    },
    {
      "key": "entry_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Public",
      "item": [
        {
          "name": "Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/config",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1 \u00b7 Auth",
      "item": [
        {
          "name": "Register (new client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"Client\",\n  \"date_of_birth\": \"1995-05-20\",\n  \"gender\": \"female\",\n  \"email\": \"test.client+1@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"0772123456\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true,\n  \"accept_emergency\": true,\n  \"device_name\": \"Postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Use a CLIENT account (e.g. joseph kanyike's). Therapists/admins get 403 not_client.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joseph@example.com\",\n  \"password\": \"your-password\",\n  \"device_name\": \"Postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joseph@example.com\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Log out (this device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
