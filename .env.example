APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (2026-11-02). Which service starts new Mobile Money payments:
# flutterwave (default) or marzpay. Real keys go ONLY in the server's .env.
PAYMENT_GATEWAY=flutterwave

# MarzPay (wallet.wearemarz.com → API Keys). Placeholders only.
MARZPAY_API_BASE=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=
MARZPAY_API_SECRET=
# Dashboard → webhook signing secret (whsec_...). Empty = callbacks are accepted but always re-checked.
MARZPAY_WEBHOOK_SECRET=
# Empty = this site's own https://.../webhooks/marzpay
MARZPAY_CALLBACK_URL=
# true while the MarzPay business account is in sandbox mode
MARZPAY_SANDBOX=true
# true while testing: keeps request/response/callback bodies in storage/logs/marzpay.log
MARZPAY_LOG_PAYLOADS=false

# The "Simulate approval / failure" buttons (no money moves). Leave false except for sandbox testing.
PAYMENT_TEST_MODE=false
# Minutes the client waits on "Approve on your phone" before we stop (late approvals are still recorded)
PAYMENT_WAIT_MINUTES=3
